;	B4-8 : B4-9			B4-8 : B4-15
;	B11-6 : B11-15			B11-6 : B11-15
;	A11-6 : A11-13			A11-6 : A11-11
;	A11-8 : A11-7			A11-8 : A11-9
;
;	B3-6 : B3-10	These are now	B3-5 : B3-10
;	B3-5 : B3-7	wired in by	B3-6 : B3-7
;			machine
